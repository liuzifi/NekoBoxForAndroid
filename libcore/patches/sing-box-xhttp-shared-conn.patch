+// MarkUnreusable retires this client: no new session will be handed out on it,
+// while the sessions already running on it keep working until they finish.
+// It is called by the underlying DialerClient. This must NOT close the
+// connection immediately, otherwise every session sharing it is reset.
+func (c *XmuxClient) MarkUnreusable() {
+	c.mtx.Lock()
+	defer c.mtx.Unlock()
+	if c.unreusableAt.IsZero() || c.unreusableAt.After(time.Now()) {
+		c.unreusableAt = time.Now()
+	}
+}
+
+// setUnreusableAt schedules the retirement of this client at the given moment.
+func (c *XmuxClient) setUnreusableAt(t time.Time) {
+	c.mtx.Lock()
+	defer c.mtx.Unlock()
+	c.unreusableAt = t
+}
+
+// IsUnreusable reports whether the client has been retired.
+func (c *XmuxClient) IsUnreusable(now time.Time) bool {
+	c.mtx.Lock()
+	defer c.mtx.Unlock()
+	return !c.unreusableAt.IsZero() && (now.After(c.unreusableAt) || now.Equal(c.unreusableAt))
+}
+
+// GetUnreusableAt returns the moment the client was retired, or the zero time
+// when it is still reusable.
+func (c *XmuxClient) GetUnreusableAt() time.Time {
+	c.mtx.Lock()
+	defer c.mtx.Unlock()
+	return c.unreusableAt
+}
