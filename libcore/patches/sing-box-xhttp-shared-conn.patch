+// SetRetireFunc binds the graceful retire callback supplied by the XmuxClient
+// that owns this connection.
+func (c *DefaultDialerClient) SetRetireFunc(retireFunc func()) {
+	c.mtx.Lock()
+	c.retireFunc = retireFunc
+	c.mtx.Unlock()
+}
+
+// Retire retires this connection gently: it is no longer handed out to new
+// sessions, but the streams already running on it are allowed to finish.
+// This is the correct reaction to a fatal transport error, because the whole
+// http2/http3 connection is shared by every session of the XmuxClient.
+// c.Close() must only be used when the connection has to be destroyed now.
+func (c *DefaultDialerClient) Retire() {
+	c.retireOnce.Do(func() {
+		c.mtx.RLock()
+		retireFunc := c.retireFunc
+		c.mtx.RUnlock()
+		if retireFunc != nil {
+			retireFunc()
+			return
+		}
+		c.Close()
+	})
+}
+
+// isStreamLocalError reports whether err only affected a single stream, so the
+// shared connection must be kept alive for the other sessions running on it.
+func isStreamLocalError(err error) bool {
+	if err == nil {
+		return true
+	}
+	if errors.Is(err, context.Canceled) ||
+		errors.Is(err, context.DeadlineExceeded) ||
+		errors.Is(err, net.ErrClosed) ||
+		errors.Is(err, io.EOF) ||
+		errors.Is(err, io.ErrClosedPipe) {
+		return true
+	}
+	var streamError http2.StreamError
+	if errors.As(err, &streamError) {
+		return true
+	}
+	var goAwayError http2.GoAwayError
+	if errors.As(err, &goAwayError) {
+		return true
+	}
+	return false
+}
